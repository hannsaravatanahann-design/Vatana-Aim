--========================================================
-- FPS / MS UPDATE
--========================================================

local frames = 0
local elapsed = 0
local currentFPS = 0

local function getPing()
    local success, value = pcall(function()
        local network = Stats:FindFirstChild("Network")
        local serverStats = network
            and network:FindFirstChild("ServerStatsItem")
        local dataPing = serverStats
            and serverStats:FindFirstChild("Data Ping")

        if dataPing then
            return dataPing:GetValue()
        end

        return nil
    end)

    if success and typeof(value) == "number" then
        return tostring(math.floor(value))
    end

    return "--"
end

--========================================================
-- MAIN UPDATE LOOP
--========================================================

RunService.RenderStepped:Connect(function(deltaTime)
    updateFOV()

    -- Count frames for FPS
    frames += 1
    elapsed += deltaTime

    if elapsed >= 1 then
        currentFPS = math.floor(frames / elapsed)
        frames = 0
        elapsed = 0

        if statsPanel.Visible then
            statsLabel.Text = string.format(
                "FPS: %d | MS: %s",
                currentFPS,
                getPing()
            )
        end
    end

    -- Animate the dragon around the floating AIM icon
    if DRAGON_IMAGE_ID ~= 0 and icon.Visible then
        local t = os.clock() * 1.8
        local center = icon.AbsolutePosition + icon.AbsoluteSize / 2

        dragon.Position = UDim2.fromOffset(
            center.X + math.cos(t) * 48,
            center.Y + math.sin(t) * 48
        )

        dragon.Rotation = math.deg(t) + 90
        dragon.Visible = true
    else
        dragon.Visible = false
    end
end)

