local iconDragging = false
local iconMoved = false
local iconStart
local iconStartPosition

icon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        iconDragging = true
        iconMoved = false
        iconStart = input.Position
        iconStartPosition = icon.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not iconDragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - iconStart

        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            iconMoved = true
        end

        icon.Position = UDim2.new(
            iconStartPosition.X.Scale,
            iconStartPosition.X.Offset + delta.X,
            iconStartPosition.Y.Scale,
            iconStartPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        iconDragging = false
    end
end)

icon.Activated:Connect(function()
    if iconMoved then
        iconMoved = false
        return
    end

    main.Visible = true
    icon.Visible = false
end)

